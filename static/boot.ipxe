#!ipxe

# Lab Manager iPXE Boot Script

echo Lab Manager Boot System
echo Getting server configuration...

# Get server MAC address
set mac ${net0/mac}
echo MAC Address: ${mac}

# Use standard autoexec.ipxe endpoint (iPXE default)
chain http://192.168.1.100:8098/api/v1/autoexec.ipxe?mac=${mac} ||

# Fallback to legacy endpoint
echo Trying legacy boot endpoint...
chain http://192.168.1.100:8098/api/v1/boot/${mac} ||

# Fallback to local boot if metadata service unavailable
echo Lab Manager unavailable, booting from local disk
sanboot --no-describe --drive 0x80 ||

# Final fallback
echo Boot failed
shell